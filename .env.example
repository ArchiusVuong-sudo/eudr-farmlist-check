# Port the app listens on (127.0.0.1 only)
PORT=4121
# Model for the column-mapping proposal: claude-sonnet-5-5 (default), claude-opus-5-5 or claude-haiku-5-5
FARMCHECK_MODEL=claude-sonnet-5-5
# 1 = never call the model, use the recorded proposals in fixtures/mapping
DEMO_REPLAY=0
# Optional. Without it the local Claude Code login is used; with neither, the app runs in replay mode
ANTHROPIC_API_KEY=
# Optional. Where the embedded PostGIS keeps its data (default var/pgdata)
FARMCHECK_DATA_DIR=
